# ──────────────────────────────────────────────
# BizBuy — Environment Variables
# Copy to .env.local and fill in real values:
#   cp .env.example .env.local
# ──────────────────────────────────────────────

# ── Backend (Python/FastAPI) ──────────────────

# Required — OpenRouter API key for all LLM agent calls (z-ai/glm-5.1)
OPENROUTER_API_KEY=

# Optional — OpenRouter HTTP-Referer header (defaults to https://bizbuy.local)
# OPENROUTER_REFERRER=https://yourdomain.com

# Required — Mistral API key for OCR document classification
MISTRAL_API_KEY=

# Environment label (default: development)
# BIZBUY_ENV=development

# Report mode (default: deterministic)
# REPORT_MODE=deterministic

# Allowed CORS origins, comma-separated (default: http://localhost:3000,http://127.0.0.1:3000)
# FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Feature flags (all default to true)
# BIZBUY_PIPELINE_ENABLED=true
# BIZBUY_ANALYSIS_JOBS_ENABLED=true
# BIZBUY_PIPELINE_ALLOW_PARTIAL_FAILURES=true
# BIZBUY_PIPELINE_ENABLE_SYNTHESIS=true

# Pipeline tuning
# BIZBUY_PIPELINE_RETRY_ATTEMPTS=1
# BIZBUY_PIPELINE_STAGE_TIMEOUT_SECONDS=90

# Artifact storage directory (default: backend/.artifacts)
# BIZBUY_ARTIFACT_DIR=backend/.artifacts

# Upload directory for document classification (default: uploads)
# BIZBUY_UPLOAD_DIR=uploads

# Production security controls
# In production, expensive backend routes require a bearer token by default.
# Keep this server-side only; do not expose it through NEXT_PUBLIC_* variables.
# BIZBUY_REQUIRE_EXPENSIVE_ROUTE_AUTH=true
# BIZBUY_API_BEARER_TOKEN=
# BIZBUY_RATE_LIMIT_ENABLED=true
# BIZBUY_UPLOAD_RATE_LIMIT=60
# BIZBUY_PARSE_RATE_LIMIT=60
# BIZBUY_ANALYSIS_RATE_LIMIT=30
# BIZBUY_SSE_RATE_LIMIT=60
# BIZBUY_UPLOAD_BYTES_PER_WINDOW=209715200
# BIZBUY_MAX_UPLOAD_FILES=10
# BIZBUY_MAX_UPLOAD_REQUEST_BYTES=104857600
# BIZBUY_MAX_ZIP_ENTRIES=256
# BIZBUY_MAX_ZIP_UNCOMPRESSED_BYTES=52428800
# BIZBUY_MAX_ACTIVE_ANALYSIS_JOBS=20
# BIZBUY_MAX_ACTIVE_SSE_CONNECTIONS=5
# BIZBUY_TRUST_X_FORWARDED_FOR=false
# BIZBUY_TRUSTED_PROXY_IPS=

# Production-safe debug and retention defaults
# BIZBUY_PIPELINE_PROMPT_DEBUG_ARTIFACTS_ENABLED=false
# BIZBUY_PIPELINE_PROMPT_DEBUG_INCLUDE_BODIES=false
# BIZBUY_DELETE_UPLOADS_AFTER_INGEST=true
# BIZBUY_RETENTION_CLEANUP_ON_STARTUP=false
# BIZBUY_UPLOAD_RETENTION_SECONDS=86400
# BIZBUY_OCR_ARTIFACT_RETENTION_SECONDS=604800
# BIZBUY_ANALYSIS_ARTIFACT_RETENTION_SECONDS=2592000
# BIZBUY_API_DOCS_ENABLED=false

# ── Frontend (Next.js) ────────────────────────

# Server-side backend URL used by the Next.js proxy/BFF.
# Do not expose backend bearer tokens with a NEXT_PUBLIC_* prefix.
BIZBUY_BACKEND_URL=http://localhost:8000/api

# Public app URL used for metadata and production Docker builds
NEXT_PUBLIC_APP_URL=http://localhost:3000
